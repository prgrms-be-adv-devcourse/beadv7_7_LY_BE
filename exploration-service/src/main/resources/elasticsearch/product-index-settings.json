{
  "analysis": {
    "tokenizer": {
      "korean_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed"
      }
    },
    "filter": {
      "korean_pos": {
        "type": "nori_part_of_speech",
        "stoptags": [
          "JKB", "JKC", "JKG", "JKO", "JKQ", "JKS", "JKV", "JX", "JC",
          "EP", "EF", "EC", "ETN", "ETM",
          "SP", "SSC", "SSO", "SC", "SE"
        ]
      }
    },
    "analyzer": {
      "korean": {
        "type": "custom",
        "tokenizer": "korean_tokenizer",
        "filter": ["korean_pos", "cjk_width", "lowercase", "asciifolding"]
      },
      "latin": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["cjk_width", "lowercase", "asciifolding"]
      }
    }
  }
}
